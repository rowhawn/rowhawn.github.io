---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" description="The requested page does not exist.">
  <h1 class="m-0 text-xl font-semibold text-sage-900 dark:text-sage-100">404</h1>
  <p class="mt-3 text-sage-600 dark:text-sage-400">This page could not be found.</p>
  <p class="mt-6">
    <a href="/">Return home</a>
  </p>
</BaseLayout>
